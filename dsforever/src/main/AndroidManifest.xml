<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Streaming (S2): the PC on the LAN (normal permissions, no prompt; the launcher already holds them) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <application>
        <!-- Streaming mode (S2): WoW on the PC through Moonlight's core, on the top screen; the companion stays on the bottom -->
        <activity
            android:name="com.jrees.wowcompanion.stream.StreamActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density" />
        <!-- Settings > Frame generation: picks the player's own Lossless.dll (FrameGenPickActivity.kt) -->
        <activity
            android:name="com.jrees.wowcompanion.FrameGenPickActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <!-- The safe close before an install (SafeCloseReceiver.kt): the game's own Exit Game, so it writes its saved state. DUMP is held by
             the system and the adb shell, never by a normal app: only an install step (adb) can ask it -->
        <receiver
            android:name="com.jrees.wowcompanion.SafeCloseReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="app.dsforever.SAFE_CLOSE" />
            </intent-filter>
        </receiver>
        <!-- TEMPORARY (the taint probe, 2026-11-08): a copy of the game's Logs/taint.log to /sdcard/WowCompanion/logs (TaintLogReceiver.kt);
             DUMP as above: only adb can ask -->
        <receiver
            android:name="com.jrees.wowcompanion.TaintLogReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="app.dsforever.COPY_TAINT" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
