<?xml version="1.0" encoding="utf-8"?>
<!-- internalOnly (p-sd-card-install, a player 2026-10-14: installed on the SD card, the container could not be made): it was the
     default already; said out loud so an installer's "prefer external" never applies. A device's "force allow on external" still can:
     the launcher's setup says so (InstallCheck). -->
<manifest xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:installLocation="internalOnly">

    <uses-feature
        android:glEsVersion="0x00020000"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.sensor.gyroscope"
        android:required="false" />

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="29"/>
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- The game-running foreground service (GameSessionService.kt; upstream v2.4.4 a3147360, the fork's 3ed7cc9c): Android is less
         likely to freeze or kill the game while another app is in front. Normal install-time permissions, no prompt. No
         POST_NOTIFICATIONS: its quiet notification stays out of the shade on Android 13+, and the service works the same. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- VOICE TO TEXT (the user, 2026-11-16: voice to text in the message box and all search boxes, "X opens our own voice prompt";
         the pick: "Android's own 'Allow microphone?' box, shown once on the bottom screen the first time you press X (never in a
         fight)"): the microphone, asked at runtime only on the player's first X (VoiceAskActivity), never at install or start. The
         game's own Wine microphone stays off (XServerScreen pins it off). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- the voice sheet's recognizers: Android 11+ lets an app see (and bind) a speech service only when it says so here -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>
    <!-- Inherited from the original launcher and unused by DS Forever: nothing changes audio settings (MODIFY_AUDIO_SETTINGS: voice
         leaves the game's sound alone, the user's pick), the crash log reads only this app's own logcat (READ_LOGS not needed), and
         DUMP is never used. Removed so no library merges them back. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_LOGS" tools:node="remove" />
    <uses-permission android:name="android.permission.DUMP" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" tools:node="remove" />

    <application
        android:name=".PluviaApp"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:allowBackup="false"
        android:extractNativeLibs="true"
        android:icon="${icon}"
        android:banner="@drawable/ic_banner"
        android:isGame="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:largeHeap="true"
        android:theme="@style/Theme.Pluvia"
        android:allowAudioPlaybackCapture="true"
        android:appCategory="game"
        tools:targetApi="29">
        <!--
         android:windowSoftInputMode must always be in the activity block.
         IME padding with composables like 'Scaffold' will have terrible resizing consequences, if in the activity tag.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="${screenOrientation}"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden|navigation"
            android:theme="@style/Theme.Pluvia">
        </activity>

        <activity-alias
            android:name=".MainActivityAliasDefault"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:banner="@drawable/ic_banner"
            android:logo="@drawable/ic_banner"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Keeps the game running locally while another app is in front (GameSessionService.kt). Not exported; started only
             by the app itself once the game's environment is up, stopped when the game exits. -->
        <service
            android:name=".GameSessionService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps a running game session alive, including its server connection, while the player switches apps." />
        </service>

        <!-- Issue 568: runs only while the indoor-maps builder builds after a game (IndoorBuildService.kt, IndoorKeepAlive.kt), so Android
             does not kill the cached app for the builder's CPU use. Not exported; the same permissions as the game-running service. -->
        <service
            android:name=".IndoorBuildService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Finishes building the player's indoor maps from the installed game's files after a game, while the player has switched apps or turned the screen off." />
        </service>

        <!-- FileProvider for secure file sharing (for APK installation) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_provider_paths" />
        </provider>
    </application>

</manifest>
